# Copy to a private local .env or a hosting service's secret-variable store.
# Do not commit actual credentials.
#
# Provision a PostgreSQL database with the PostGIS extension first.
DATABASE_URL=postgresql://meridian:replace-me@localhost:5432/meridian

# Generate a unique, random Bearer token for protected operations endpoints.
API_TOKEN=replace-with-a-long-random-secret

# Local app with the global collector disabled:
AIS_PROVIDER=aisstream
RUN_COLLECTOR=0

# Required ONLY when RUN_COLLECTOR=1:
AISSTREAM_API_KEY=

# Soft stop for database + WAL usage in MiB. Check physical volume headroom.
MAX_DATABASE_MB=250

# Platform usually assigns PORT; default is 8000.
PORT=8000
